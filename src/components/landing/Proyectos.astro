---
import { proyectos } from '../../data/portfolio';
---

<section id="proyectos">
	<div class="wrap">
		<h2>Proyectos</h2>
		<div class="grid">
			{proyectos.map((p, i) => (
				<a class="card project" href={p.url} target="_blank" rel="noopener">
					<span class="num">0{i + 1}</span>
					<h3>{p.titulo}</h3>
					<p>{p.descripcion}</p>
					<span class="link">Visitar →</span>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 20px;
	}
	.project {
		display: flex;
		flex-direction: column;
		gap: 8px;
		color: var(--ink);
		text-decoration: none;
		transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
	}
	.project:hover {
		transform: translateY(-4px);
		border-color: var(--brand);
		box-shadow: 0 10px 28px rgba(20, 22, 31, 0.08);
	}
	.project p {
		color: var(--muted);
		margin: 0;
		flex: 1;
	}
	.num {
		color: var(--brand);
		font-weight: 700;
		font-size: 0.85rem;
	}
	.link {
		color: var(--brand);
		font-weight: 700;
		font-size: 0.95rem;
	}
</style>
