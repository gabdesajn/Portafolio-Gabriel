---
import { nombre, rol } from '../../data/portfolio';
---

<section id="inicio" class="hero">
	<div class="wrap">
		<p class="eyebrow">Hola, soy</p>
		<h1>{nombre}</h1>
		<p class="role">{rol}</p>
		<p class="intro">
			Estudiante de Ingeniería en Informática y Sistemas en la Universidad Rafael Landívar.
			Diseño y desarrollo sitios web y aplicaciones móviles.
		</p>
		<div class="cta">
			<a class="btn primary" href="#proyectos">Ver proyectos</a>
			<a class="btn" href="#contacto">Contactarme</a>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: 40px 0;
		background: transparent;
	}
	.eyebrow {
		color: white;
		font-weight: 700;
		margin: 0;
	}
	.hero h1 {
		font-size: clamp(2.5rem, 7vw, 4rem);
		margin: 4px 0;
		color: white;
	}
	.role {
		font-size: 1.35rem;
		color: var(--muted);
		margin: 0 0 16px;
	}
	.intro {
		max-width: 560px;
		color: var(--muted);
	}

	@media (max-width: 760px) {
		.hero {
			padding: 72px 0 64px;
		}
	}
</style>
