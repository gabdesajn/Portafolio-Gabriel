---
import { certificaciones, educacion } from '../../data/portfolio';
---

<section id="educacion">
	<div class="wrap two-col">
		<div>
			<h2>Educación</h2>
			<div class="timeline">
				{educacion.map((ed) => (
					<article class="item">
						<div class="item-head">
							<h3>{ed.institucion}</h3>
							<span class="date">{ed.fecha}</span>
						</div>
						<p class="sub">{ed.titulo} · {ed.lugar}</p>
						{ed.detalle && <p class="detail">{ed.detalle}</p>}
					</article>
				))}
			</div>
		</div>
		<div>
			<h2>Certificaciones</h2>
			<ul class="certs">
				{certificaciones.map((c) => <li class="card">{c}</li>)}
			</ul>
		</div>
	</div>
</section>

<style>
	.two-col {
		display: grid;
		grid-template-columns: 3fr 2fr;
		gap: 48px;
	}
	.detail {
		color: var(--muted);
		margin: 0;
	}
	.certs {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 12px;
	}
	.certs li {
		font-weight: 700;
		border-left: 3px solid var(--brand);
	}

	@media (max-width: 760px) {
		.two-col {
			grid-template-columns: 1fr;
		}
	}
</style>
