---
interface Props {
	color?: string;
	opacity?: number;
	speed?: number;
	lineWeight?: number;
}
const { color = '#4f46e5', opacity = 0.35, speed = 1, lineWeight = 1 } = Astro.props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Gochi+Hand&display=swap"
/>

<svg
	class="comic-bg"
	viewBox="0 0 1920 1080"
	preserveAspectRatio="xMidYMid slice"
	aria-hidden="true"
	data-speed={speed}
	data-line-weight={lineWeight}
	style={`--comic-color:${color};--comic-opacity:${opacity}`}
>
</svg>

<style>
	.comic-bg {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		pointer-events: none;
		color: var(--comic-color);
		opacity: var(--comic-opacity);
	}
</style>

<script>
	// Fondo animado estilo cómic: trazos dibujados a mano, figuras y fragmentos de código.
	type Pt = [number, number];
	type Seg = { pts: Pt[]; smooth?: number };
	type Rand = () => number;
	type Shape = (r: Rand) => Seg[];
	type DrawOpts = { boil?: number; tm?: [number, number, number]; rot?: number; cx?: number; cy?: number };
	type DrawDef = [Shape, number, number, number, DrawOpts?];
	type TravelDef = [Pt[], number, number, number];
	type FragDef = [string, number, number, number, number, 'mono' | 'hand', number, number];

	const NS = 'http://www.w3.org/2000/svg';

	const rng = (seed: number): Rand => {
		let s = seed >>> 0 || 1;
		return () => {
			s ^= s << 13;
			s >>>= 0;
			s ^= s >> 17;
			s ^= s << 5;
			s >>>= 0;
			return s / 4294967296;
		};
	};
	const J = (pts: Pt[], a: number, r: Rand): Pt[] =>
		pts.map(([x, y]) => [x + (r() - 0.5) * 2 * a, y + (r() - 0.5) * 2 * a]);
	const f = (n: number) => n.toFixed(1);
	const cr = (pts: Pt[]) => {
		const p = [pts[0], ...pts, pts[pts.length - 1]];
		let d = `M${f(p[1][0])},${f(p[1][1])}`;
		for (let i = 1; i < p.length - 2; i++) {
			const [p0, p1, p2, p3] = [p[i - 1], p[i], p[i + 1], p[i + 2]];
			const c1x = p1[0] + (p2[0] - p0[0]) / 6;
			const c1y = p1[1] + (p2[1] - p0[1]) / 6;
			const c2x = p2[0] - (p3[0] - p1[0]) / 6;
			const c2y = p2[1] - (p3[1] - p1[1]) / 6;
			d += `C${f(c1x)},${f(c1y)} ${f(c2x)},${f(c2y)} ${f(p2[0])},${f(p2[1])}`;
		}
		return d;
	};
	const lin = (pts: Pt[]) => 'M' + pts.map((p) => f(p[0]) + ',' + f(p[1])).join('L');
	const ease = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : -(Math.cos(Math.PI * x) - 1) / 2);
	const reg = (cx: number, cy: number, R: number, n: number, rot: number): Pt[] =>
		Array.from({ length: n }, (_, i) => {
			const a = ((rot + (i * 360) / n) * Math.PI) / 180;
			return [cx + Math.cos(a) * R, cy + Math.sin(a) * R];
		});

	const stroke =
		(pts: Pt[], amp: number): Shape =>
		(r) => [{ pts: J(pts, amp, r), smooth: 1 }];
	const circ =
		(cx: number, cy: number, R: number): Shape =>
		(r) => {
			const a0 = r() * 6.28;
			const n = 11;
			const pts: Pt[] = [];
			for (let i = 0; i <= n; i++) {
				const a = a0 + (i / n) * 6.28 * 1.08;
				const rr = R * (1 + (r() - 0.5) * 0.1);
				pts.push([cx + Math.cos(a) * rr, cy + Math.sin(a) * rr]);
			}
			return [{ pts, smooth: 1 }];
		};
	const poly =
		(vs: Pt[]): Shape =>
		(r) => {
			const v = J(vs, 1.5, r);
			const [a, b] = v;
			const tail: Pt = [a[0] + (b[0] - a[0]) * 0.22, a[1] + (b[1] - a[1]) * 0.22];
			return [{ pts: [...v, a, tail], smooth: 0 }];
		};
	const plus =
		(x: number, y: number, s: number): Shape =>
		(r) => [
			{ pts: J([[x - s, y + 1], [x + s, y - 1]], 1, r) },
			{ pts: J([[x, y - s], [x + 1, y + s]], 1, r) },
		];
	const burst = (cx: number, cy: number, R1: number, R2: number, n: number) =>
		poly(
			Array.from({ length: n * 2 }, (_, i): Pt => {
				const a = (i * Math.PI) / n - Math.PI / 2;
				const R = i % 2 ? R2 : R1;
				return [cx + Math.cos(a) * R, cy + Math.sin(a) * R];
			}),
		);
	const ticks =
		(x: number, y: number): Shape =>
		(r) =>
			[0, 1, 2].map((i) => ({
				pts: J([[x + i * 12, y + 10], [x + i * 12 + 9, y - 10]], 1, r),
			}));
	const BRACE: Pt[] = [
		[36, 0], [8, 10], [0, 45], [2, 90], [-10, 114], [-24, 120],
		[-10, 126], [2, 150], [0, 195], [8, 230], [36, 240],
	];
	const brace = (x: number, y: number, h: number, dir: number): Pt[] => {
		const s = h / 240;
		return BRACE.map(([a, b]) => [x + a * s * dir, y + b * s]);
	};

	// [forma, grosor, duración del ciclo (s), desfase, opciones]
	const DRAW: DrawDef[] = [
		[stroke([[-60, 330], [40, 230], [150, 150], [290, 70], [460, -40]], 6), 3, 14, 0],
		[stroke([[-60, 400], [60, 290], [200, 190], [360, 100], [560, -40]], 6), 1.2, 14, 0.08],
		[
			stroke([[1440, 1130], [1580, 1010], [1720, 930], [1840, 860], [1990, 790]], 6),
			3, 15, 0.5,
		],
		[stroke([[1360, 1130], [1520, 990], [1680, 890], [1990, 720]], 6), 1.2, 15, 0.58],
		[stroke([[1180, 52], [1300, 34], [1420, 66], [1540, 40], [1660, 72]], 4), 1.4, 11, 0.3],
		[
			stroke([[-30, 1000], [120, 1030], [260, 990], [400, 1040], [560, 1010], [700, 1100]], 5),
			1.8, 16, 0.4,
		],
		[
			stroke(
				[
					[1560, 210], [1640, 190], [1690, 150], [1665, 110],
					[1625, 125], [1635, 170], [1700, 195], [1800, 180],
				],
				3,
			),
			2, 10, 0.2, { boil: 0.8 },
		],
		[stroke(brace(110, 380, 240, 1), 2), 2.2, 13, 0.15, { boil: 0.7 }],
		[stroke(brace(1810, 450, 240, -1), 2), 2.2, 13, 0.65, { boil: 0.7 }],
		...([[760, 150], [782, 110], [806, 175], [826, 90]] as Pt[]).map(
			([y, e], i): DrawDef => [
				stroke([[-20, y], [e * 0.5, y - 2], [e, y - 6]], 1.5),
				1.4, 7, i * 0.06, { tm: [0.2, 0.32, 0.52] },
			],
		),
		[circ(1846, 186, 22), 1.6, 16, 0.2, { boil: 1 }],
		[poly(reg(250, 840, 30, 3, -90)), 1.6, 17, 0.55, { boil: 1, rot: 3, cx: 250, cy: 840 }],
		[poly(reg(470, 945, 22, 4, 15)), 1.4, 15, 0.35, { boil: 1, rot: -2, cx: 470, cy: 945 }],
		[poly(reg(360, 130, 12, 4, 0)), 1.4, 12, 0.7, { boil: 0.8 }],
		[plus(1820, 420, 9), 1.6, 9, 0.1, { boil: 0.8 }],
		[plus(600, 56, 8), 1.4, 10, 0.6, { boil: 0.8 }],
		[plus(90, 330, 8), 1.4, 11, 0.85, { boil: 0.8 }],
		[burst(200, 690, 26, 12, 9), 1.4, 14, 0.8, { boil: 1.2 }],
		[ticks(320, 965), 1.6, 9, 0.45, { boil: 0.8 }],
		[stroke([[1296, 136], [1360, 141], [1440, 132]], 2), 1.6, 13, 0.47, { tm: [0.27, 0.6, 0.72] }],
	];

	// [puntos, grosor, duración, largo del trazo]
	const TRAVEL: TravelDef[] = [
		[[[-50, 240], [120, 120], [300, 30], [520, -60]], 2.2, 7, 0.08],
		[[[2000, 880], [1800, 960], [1640, 1040], [1500, 1140]], 2.2, 8, 0.1],
		[[[560, -30], [700, 40], [860, 20], [1020, 60], [1180, -30]], 1.4, 12, 0.12],
		[[[700, 1110], [860, 1050], [1020, 1070], [1200, 1040], [1340, 1110]], 1.4, 13, 0.12],
	];

	// [texto, x, y, rotación, tamaño, fuente, duración, desfase]
	const FRAGS: FragDef[] = [
		['</>', 220, 300, -6, 26, 'mono', 11, 0],
		['{ }', 1690, 330, 4, 24, 'mono', 12, 0.35],
		['<div class="hero">', 40, 950, -3, 17, 'mono', 13, 0.6],
		['const ship = () => {}', 1240, 985, 0, 17, 'mono', 14, 0.15],
		['def build(self):', 620, 985, 2, 17, 'mono', 12, 0.8],
		['.btn { }', 1660, 790, -4, 18, 'mono', 10, 0.5],
		['=>', 1840, 320, 0, 22, 'mono', 9, 0.7],
		['<h1/>', 470, 128, -5, 20, 'mono', 11, 0.25],
		['// ship it', 1300, 120, -2, 28, 'hand', 13, 0.45],
	];

	type DrawItem = {
		i: number;
		shape: Shape;
		dur: number;
		ph: number;
		cyc: number | null;
		segs: Seg[];
		boil: number;
		tm: [number, number, number];
		rot?: number;
		cx?: number;
		cy?: number;
		el: SVGPathElement;
	};

	function start(svg: SVGSVGElement) {
		const sp = Number(svg.dataset.speed) || 1;
		const lw = Number(svg.dataset.lineWeight) || 1;

		const mk = <T extends SVGElement>(tag: string, attrs: Record<string, string | number>) => {
			const e = document.createElementNS(NS, tag) as T;
			for (const k in attrs) e.setAttribute(k, String(attrs[k]));
			svg.appendChild(e);
			return e;
		};
		const base = {
			fill: 'none',
			stroke: 'currentColor',
			'stroke-linecap': 'round',
			'stroke-linejoin': 'round',
			pathLength: 1,
		};

		const items: DrawItem[] = DRAW.map(([shape, w, dur, ph, o = {}], i) => ({
			i,
			shape,
			dur,
			ph,
			cyc: null,
			segs: [],
			boil: o.boil || 0,
			tm: o.tm || [0.3, 0.6, 0.9],
			rot: o.rot,
			cx: o.cx,
			cy: o.cy,
			el: mk<SVGPathElement>('path', { ...base, 'stroke-dasharray': '1 1', 'stroke-width': w * lw }),
		}));

		const travels = TRAVEL.map(([pts, w, dur, len]) => ({
			dur,
			el: mk<SVGPathElement>('path', {
				...base,
				'stroke-dasharray': `${len} ${1 - len}`,
				'stroke-width': w * lw,
				d: cr(pts),
			}),
		}));

		const frags = FRAGS.map(([str, x, y, rot, size, font, dur, ph]) => ({
			str,
			x,
			y,
			rot,
			dur,
			ph,
			font,
			shown: -1,
			el: mk<SVGTextElement>('text', {
				fill: 'currentColor',
				'font-size': size,
				'font-family': font === 'hand' ? "'Gochi Hand', cursive" : "'JetBrains Mono', monospace",
				style: 'font-variant-ligatures:none;font-feature-settings:"liga" 0,"calt" 0',
				opacity: 0,
			}),
		}));

		const setD = (it: DrawItem, seed: number) => {
			const r2 = rng(seed);
			const d = it.segs.map((s) => {
				const p = it.boil ? J(s.pts, it.boil, r2) : s.pts;
				return s.smooth ? cr(p) : lin(p);
			});
			it.el.setAttribute('d', d.join(''));
		};

		let t = 0;
		let boilAcc = 0;
		let bt = 0;

		const render = (dt: number) => {
			t += dt * sp;
			boilAcc += dt;
			const boilNow = boilAcc > 0.12;
			if (boilNow) {
				boilAcc = 0;
				bt++;
			}

			for (const tr of travels) {
				tr.el.setAttribute('stroke-dashoffset', String(-((t / tr.dur) % 1)));
			}

			for (const it of items) {
				const u = t / it.dur + it.ph;
				const c = Math.floor(u);
				const p = u - c;
				const [a, b, e] = it.tm;
				if (c !== it.cyc) {
					it.cyc = c;
					it.segs = it.shape(rng(c * 9973 + it.i * 131 + 7));
					setD(it, bt * 31 + it.i);
				} else if (it.boil && boilNow) {
					setD(it, bt * 31 + it.i);
				}

				let off: number;
				let vis = 1;
				if (p < a) off = 1 - ease(p / a);
				else if (p < b) off = 0;
				else if (p < e) off = -ease((p - b) / (e - b));
				else {
					off = 1;
					vis = 0;
				}
				if (p < 0.004) vis = 0;
				it.el.setAttribute('stroke-dashoffset', String(off));
				it.el.setAttribute('opacity', String(vis));
				if (it.rot) {
					const bob = f(Math.sin(t * 0.6 + it.i) * 4);
					it.el.setAttribute('transform', `translate(0 ${bob}) rotate(${f(t * it.rot)} ${it.cx} ${it.cy})`);
				}
			}

			for (const fr of frags) {
				const p = (t / fr.dur + fr.ph) % 1;
				let op = 0;
				let n = fr.str.length;
				if (p < 0.2) {
					op = fr.font === 'hand' ? ease(p / 0.2) : 1;
					if (fr.font !== 'hand') n = Math.ceil(fr.str.length * Math.min(1, p / 0.17));
				} else if (p < 0.6) op = 1;
				else if (p < 0.75) op = 1 - ease((p - 0.6) / 0.15);
				if (p < 0.003) n = 0;
				if (n !== fr.shown) {
					fr.el.textContent = fr.str.slice(0, n);
					fr.shown = n;
				}
				const dy = -14 * ease(Math.min(1, p / 0.75));
				const dx = Math.sin(t * 0.4 + fr.x) * 3;
				fr.el.setAttribute('opacity', f(op * 0.92));
				fr.el.setAttribute('transform', `translate(${f(fr.x + dx)} ${f(fr.y + dy)}) rotate(${fr.rot})`);
			}
		};

		// Si el usuario pidió menos movimiento, se dibuja un solo cuadro fijo.
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
			render(4);
			return;
		}
		let last = performance.now();
		const loop = (now: number) => {
			render(Math.min(0.05, (now - last) / 1000));
			last = now;
			requestAnimationFrame(loop);
		};
		requestAnimationFrame(loop);
	}

	const svg = document.querySelector<SVGSVGElement>('svg.comic-bg');
	if (svg) start(svg);
</script>
